function animateDashCounters() {
    var $counters = $('.rac-dash-metric__value[data-count]');
    if (!$counters.length) return;

    $counters.each(function(index) {
        var $el = $(this);
        var target = parseInt($el.attr('data-count'), 10) || 0;
        if (target === 0) {
            $el.text('0');
            return;
        }

        $el.text('0');
        var duration = 1200;
        var startDelay = index * 40;
        var startTime = null;

        function easeOutExpo(x) {
            return x === 1 ? 1 : 1 - Math.pow(2, -10 * x);
        }

        function frame(now) {
            if (!startTime) startTime = now;
            var elapsed = now - startTime - startDelay;

            if (elapsed < 0) {
                requestAnimationFrame(frame);
                return;
            }

            var progress = Math.min(elapsed / duration, 1);
            var val = Math.round(target * easeOutExpo(progress));
            $el.text(val.toLocaleString());

            if (progress < 1) {
                requestAnimationFrame(frame);
            } else {
                $el.text(target.toLocaleString());
            }
        }

        requestAnimationFrame(frame);
    });
}


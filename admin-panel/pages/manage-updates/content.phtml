<?php
$ramzaVersion = function_exists('Ramza_UpdateCurrentVersion') ? Ramza_UpdateCurrentVersion() : ($wo['script_version'] ?? '1.0');
$backupDir = function_exists('Ramza_UpdateDirectory') ? Ramza_UpdateDirectory() . DIRECTORY_SEPARATOR . 'backups' : '';
$hasSnapshots = is_dir($backupDir) && count(glob($backupDir . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR) ?: []) > 0;
$latestBackupTime = '';
if ($hasSnapshots) {
    $folders = glob($backupDir . DIRECTORY_SEPARATOR . '*', GLOB_ONLYDIR) ?: [];
    rsort($folders, SORT_STRING);
    if (!empty($folders[0])) {
        $latestBackupTime = date('M j, Y \a\t H:i', filemtime($folders[0]));
    }
}
$sessionHash = Wo_CreateSession();

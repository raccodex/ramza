<script>
(function() {
    'use strict';
    const endpoint = Wo_Ajax_Requests_File() + '?f=ramza_update';
    const hash = <?php echo json_encode($sessionHash); ?>;
    const alertBox = $('#update-alert-container');
    let nextVersion = '';
    let isWorking = false;

    // Toast alert banner
    function showAlert(msg, isSuccess) {
        const cls = isSuccess ? 'alert-success' : 'alert-danger';
        alertBox.html('<div class="alert ' + cls + ' alert-dismissible fade show border-0 shadow-sm" role="alert" style="border-radius: 8px; font-weight: 600;">' +
            msg +
            '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>' +
            '</div>');
    }

    // Toggle Check Button Spinner
    function setCheckLoading(loading) {
        isWorking = loading;
        $('#btn-check-updates').prop('disabled', loading);
        $('#check-spinner').toggleClass('d-none', !loading);
        $('#check-icon').toggleClass('d-none', loading);
    }

    // Check for Updates
    $('#btn-check-updates').on('click', function() {
        if (isWorking) return;
        setCheckLoading(true);
        alertBox.empty();
        $('#available-updates-wrap').addClass('d-none');
        $('#btn-install-update').addClass('d-none');
        $('#scan-feedback-box').addClass('d-none');
        $('#update-status-badge').attr('class', 'badge-status badge-neutral').text('Checking...');

        $.post(endpoint + '&s=check', { hash_id: hash })
            .done(function(data) {
                if (data.ok && data.available && data.release) {
                    nextVersion = data.release.version || '';
                    $('#update-status-badge').attr('class', 'badge-status badge-warning-soft').text('Update Available');
                    $('#new-version-title').text('Ramza v' + nextVersion + ' is available');
                    $('#new-version-notes').text(data.release.notes || 'A new verified update is available.');
                    $('#available-updates-wrap').removeClass('d-none');
                    $('#btn-install-update').removeClass('d-none').find('#install-btn-text').text('Install v' + nextVersion);
                } else if (data.ok) {
                    $('#update-status-badge').attr('class', 'badge-status badge-success-soft').text('Up to Date');
                    $('#feedback-icon').text('check_circle').parent().parent().attr('class', 'feedback-banner mb-3');
                    $('#feedback-text').text(data.message || 'You are running the latest version. Everything is up to date.');
                    $('#scan-feedback-box').removeClass('d-none');
                } else {
                    $('#update-status-badge').attr('class', 'badge-status badge-danger-soft').text('Check Failed');
                    $('#feedback-icon').text('error_outline').parent().parent().attr('class', 'feedback-banner feedback-err mb-3');
                    $('#feedback-text').text(data.message || 'Could not complete update check.');
                    $('#scan-feedback-box').removeClass('d-none');
                }
            })
            .fail(function(xhr) {
                $('#update-status-badge').attr('class', 'badge-status badge-danger-soft').text('Offline');
                $('#feedback-icon').text('cloud_off').parent().parent().attr('class', 'feedback-banner feedback-err mb-3');
                const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Unable to connect to update service.';
                $('#feedback-text').text(msg);
                $('#scan-feedback-box').removeClass('d-none');
            })
            .always(function() {
                setCheckLoading(false);
            });
    });

    // Install Discovered Update
    $('#btn-install-update').on('click', function() {
        if (isWorking || !nextVersion) return;
        if (!window.confirm('Install update v' + nextVersion + '?\n\nA backup snapshot will be created automatically before applying files.')) {
            return;
        }

        const btn = $(this);
        isWorking = true;
        btn.prop('disabled', true);
        btn.find('#install-spinner').removeClass('d-none');
        $('#btn-check-updates').prop('disabled', true);
        $('#update-status-badge').attr('class', 'badge-status badge-neutral').text('Installing...');

        $.post(endpoint + '&s=install', { hash_id: hash, expected_version: nextVersion })
            .done(function(data) {
                if (data.ok) {
                    $('#update-status-badge').attr('class', 'badge-status badge-success-soft').text('Installed');
                    showAlert('Update v' + (data.version || nextVersion) + ' installed successfully. Reloading...', true);
                    btn.addClass('d-none');
                    setTimeout(function() { window.location.reload(); }, 1800);
                } else {
                    $('#update-status-badge').attr('class', 'badge-status badge-danger-soft').text('Failed');
                    showAlert(data.message || 'Update failed. Original files were preserved.', false);
                }
            })
            .fail(function(xhr) {
                $('#update-status-badge').attr('class', 'badge-status badge-danger-soft').text('Failed');
                const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Installation error.';
                showAlert(msg, false);
            })
            .always(function() {
                isWorking = false;
                btn.prop('disabled', false);
                btn.find('#install-spinner').addClass('d-none');
                $('#btn-check-updates').prop('disabled', false);
            });
    });

    // Manual Upload Drag & Drop
    const dropzone = $('#dropzone-area');
    const fileInput = $('#input-update-file');
    const promptWrap = $('#dropzone-prompt');
    const fileInfoWrap = $('#dropzone-file-info');
    const fileNameEl = $('#selected-file-name');
    const fileSizeEl = $('#selected-file-size');

    function formatSize(bytes) {
        if (!bytes) return '0 B';
        const k = 1024, sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function selectFile(file) {
        if (!file) return;
        if (!file.name.toLowerCase().endsWith('.zip')) {
            alert('Please select a valid ZIP archive (.zip).');
            fileInput.val('');
            return;
        }
        fileNameEl.text(file.name);
        fileSizeEl.text(formatSize(file.size));
        promptWrap.addClass('d-none');
        fileInfoWrap.removeClass('d-none').addClass('d-flex');
    }

    function clearFile() {
        fileInput.val('');
        fileInfoWrap.addClass('d-none').removeClass('d-flex');
        promptWrap.removeClass('d-none');
    }

    $('#btn-remove-file').on('click', function(e) {
        e.stopPropagation();
        clearFile();
    });

    fileInput.on('change', function() {
        if (this.files && this.files[0]) {
            selectFile(this.files[0]);
        }
    });

    dropzone.on('dragover dragenter', function(e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.addClass('drag-active');
    });
    dropzone.on('dragleave dragend drop', function(e) {
        e.preventDefault();
        e.stopPropagation();
        dropzone.removeClass('drag-active');
    });

    // Submit Manual Upload
    $('#form-manual-upload').on('submit', function(e) {
        e.preventDefault();
        const files = fileInput[0].files;
        if (!files || files.length === 0) {
            alert('Please choose an update ZIP package first.');
            return;
        }

        if (!window.confirm('Install update package "' + files[0].name + '"?\n\nA backup snapshot will be created automatically before applying files.')) {
            return;
        }

        const submitBtn = $('#btn-submit-manual');
        const progressWrap = $('#upload-progress-wrap');
        const progressBar = $('#upload-progress-bar');
        const progressPct = $('#progress-percent-label');
        const progressStatus = $('#progress-status-label');

        submitBtn.prop('disabled', true);
        submitBtn.find('#manual-spinner').removeClass('d-none');
        submitBtn.find('#manual-icon').addClass('d-none');
        progressWrap.removeClass('d-none');
        progressBar.css('width', '0%');
        progressPct.text('0%');
        progressStatus.text('Uploading package...');

        const formData = new FormData(this);

        $.ajax({
            url: endpoint + '&s=manual',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            xhr: function() {
                const xhr = new window.XMLHttpRequest();
                xhr.upload.addEventListener('progress', function(evt) {
                    if (evt.lengthComputable) {
                        const pct = Math.round((evt.loaded / evt.total) * 100);
                        progressBar.css('width', pct + '%');
                        progressPct.text(pct + '%');
                        if (pct >= 100) {
                            progressStatus.text('Verifying & applying update...');
                        }
                    }
                }, false);
                return xhr;
            }
        })
        .done(function(result) {
            if (result.ok) {
                showAlert('Package installed successfully (v' + (result.version || 'Updated') + '). Reloading...', true);
                clearFile();
                setTimeout(function() { window.location.reload(); }, 1800);
            } else {
                showAlert(result.message || 'Package installation failed.', false);
            }
        })
        .fail(function(xhr) {
            const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Error uploading update package.';
            showAlert(msg, false);
        })
        .always(function() {
            submitBtn.prop('disabled', false);
            submitBtn.find('#manual-spinner').addClass('d-none');
            submitBtn.find('#manual-icon').removeClass('d-none');
            setTimeout(function() { progressWrap.addClass('d-none'); }, 3000);
        });
    });

    // Rollback Snapshot
    $('#btn-rollback').on('click', function() {
        if (!window.confirm('Revert to the latest pre-update snapshot?\n\nThis will restore modified files to their previous state.')) {
            return;
        }

        const btn = $(this);
        btn.prop('disabled', true);
        btn.find('#rollback-spinner').removeClass('d-none');

        $.post(endpoint + '&s=rollback', { hash_id: hash })
            .done(function(data) {
                if (data.ok) {
                    showAlert('Snapshot restored successfully. Reloading...', true);
                    setTimeout(function() { window.location.reload(); }, 1800);
                } else {
                    showAlert(data.message || 'Snapshot rollback failed.', false);
                }
            })
            .fail(function(xhr) {
                const msg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Rollback request failed.';
                showAlert(msg, false);
            })
            .always(function() {
                btn.prop('disabled', false);
                btn.find('#rollback-spinner').addClass('d-none');
            });
    });
})();
</script>

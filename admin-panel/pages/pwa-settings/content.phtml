<?php
$rac_pwa_value = static function ($key, $default = '') use ($wo) {
    return htmlspecialchars((string)($wo['config'][$key] ?? $default), ENT_QUOTES, 'UTF-8');
};

$rac_pwa_checked = static function ($key, $default = '0') use ($wo) {
    return ((string)($wo['config'][$key] ?? $default) === '1') ? 'checked' : '';
};

$rac_pwa_selected = static function ($key, $value, $default = '') use ($wo) {
    return ((string)($wo['config'][$key] ?? $default) === (string)$value) ? 'selected' : '';
};

$rac_pwa_icon_url = static function ($key) use ($wo) {
    if (!empty($wo['config'][$key])) {
        return Wo_GetMedia($wo['config'][$key]);
    }
    return $wo['config']['theme_url'] . '/img/icon.png';
};


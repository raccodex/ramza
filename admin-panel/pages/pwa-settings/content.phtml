<script>
$(function () {
    $('[data-rac-pwa-color-picker]').on('input change', function () {
        var key = $(this).data('rac-pwa-color-picker');
        $('[data-rac-pwa-color-text="' + key + '"]').val($(this).val()).trigger('input');
    });

    $('[data-rac-pwa-color-text]').on('input change', function () {
        var value = $(this).val();
        var key = $(this).data('rac-pwa-color-text');
        if (/^#[0-9A-Fa-f]{6}$/.test(value)) {
            $('[data-rac-pwa-color-picker="' + key + '"]').val(value);
            if (key === 'theme') {
                $('[data-rac-pwa-preview-button]').css('background', value);
            }
        }
    });

    $('input[name="pwa_app_name"]').on('input', function () {
        $('[data-rac-pwa-preview-name]').text($(this).val() || 'Ramza');
    });

    $('[data-rac-pwa-file]').on('change', function () {
        var input = this;
        var previewKey = $(input).data('rac-pwa-file');
        if (!input.files || !input.files[0]) {
            return;
        }
        var reader = new FileReader();
        reader.onload = function (event) {
            $('[data-rac-pwa-preview="' + previewKey + '"]').attr('src', event.target.result);
            if (previewKey === 'pwa_icon_192') {
                $('[data-rac-pwa-preview="banner_icon"]').attr('src', event.target.result);
            }
        };
        reader.readAsDataURL(input.files[0]);
    });

    $('.rac-pwa-settings').on('submit', function (event) {
        event.preventDefault();
        var form = $(this);
        var button = form.find('.rac-pwa-save');
        var originalText = button.text();
        var formData = new FormData(this);

        button.prop('disabled', true).text('Saving...');
        $('.pwa-settings-alert').html('');

        $.ajax({
            url: Wo_Ajax_Requests_File() + '?f=admin_setting&s=update_general_setting',
            type: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            dataType: 'json',
            success: function (data) {
                if (data.status == 200) {
                    $('.pwa-settings-alert').html('<div class="alert alert-success">PWA settings saved. Public install banner and offline app metadata will use the new configuration.</div>');
                } else {
                    $('.pwa-settings-alert').html('<div class="alert alert-danger">' + (data.message || 'PWA settings could not be saved.') + '</div>');
                }
                button.prop('disabled', false).text(originalText);
            },
            error: function () {
                $('.pwa-settings-alert').html('<div class="alert alert-danger">PWA settings could not be saved. Please check the uploaded icon files and try again.</div>');
                button.prop('disabled', false).text(originalText);
            }
        });
    });
});
</script>

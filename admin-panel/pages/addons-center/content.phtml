</div>
<style>
.ramza-addons-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.ramza-addons-version{margin-top:7px;padding:5px 9px;border:1px solid #d7dde2;border-radius:5px;color:#5e6972;font-size:11px;font-weight:800}.ramza-addon-list{border-top:1px solid #d9dee2;background:#fff}.ramza-addon-row{display:grid;grid-template-columns:42px minmax(260px,1fr) auto auto;align-items:center;gap:18px;padding:20px 18px;border:1px solid #d9dee2;border-top:0}.ramza-addon-symbol{display:grid;place-items:center;width:38px;height:38px;border-radius:7px;background:#202f3a;color:#fff;font-weight:900}.ramza-addon-copy h4{margin:0 0 4px;font-size:15px}.ramza-addon-copy p{margin:0;color:#6d7881;font-size:12px}.ramza-addon-pill{padding:5px 9px;border-radius:999px;background:#f0f2f3;color:#66717a;font-size:10px;font-weight:900;text-transform:uppercase}.ramza-addon-row.is-licensed .ramza-addon-pill{background:#e6f3ec;color:#246a4c}.ramza-addon-actions{display:flex;gap:8px}.ramza-addon-buy{background:#283d4c!important;color:#fff!important}.ramza-addon-modal-content{border:1px solid #d6dce0;border-radius:8px;box-shadow:0 18px 55px rgba(25,35,43,.18)}@media(max-width:760px){.ramza-addon-row{grid-template-columns:42px 1fr}.ramza-addon-pill,.ramza-addon-actions,.ramza-addon-row>.btn{grid-column:2;justify-self:start}}
</style>
<script>
$(document).on('click','.ramza-addon-activate',function(){
    $('#ramza-addon-feature').val($(this).data('feature'));
    $('#ramza-addon-modal .modal-title').text('Activate ' + $(this).data('name'));
    $('#ramza-addon-code').val('');
    $('#ramza-addon-modal').modal('show');
});
$(document).on('submit','#ramza-addon-activation-form',function(event){
    event.preventDefault();
    var form=$(this), button=form.find('[type=submit]'); button.prop('disabled',true).text('Checking');
    $.post(Wo_Ajax_Requests_File()+'?f=addons&s=activate',form.serialize(),function(data){
        if(data.status===200){window.location.reload();return;}
        $('#ramza-addon-alert').html('<div class="alert alert-danger">'+$('<div>').text(data.message||'Activation failed.').html()+'</div>');
    },'json').fail(function(xhr){var data=xhr.responseJSON||{};$('#ramza-addon-alert').html('<div class="alert alert-danger">'+$('<div>').text(data.message||'Activation failed.').html()+'</div>');}).always(function(){button.prop('disabled',false).text('Activate');$('#ramza-addon-modal').modal('hide');});
});
</script>


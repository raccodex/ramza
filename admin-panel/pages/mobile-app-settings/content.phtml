<script>
$(function () {
    function submitMobileSettings() {
        var form = $('.rac-mobile-form');
        var buttons = form.find('button');
        buttons.prop('disabled', true);
        $('.mobile-app-settings-alert').empty();
        $.ajax({
            url: Wo_Ajax_Requests_File() + '?f=admin_setting&s=update_mobile_app_settings',
            type: 'POST',
            data: form.serialize(),
            dataType: 'json'
        }).done(function (data) {
            var ok = Number(data.status) === 200;
            var message = $('<div>').text(data.message || (ok ? 'Mobile settings saved.' : 'Mobile settings could not be saved.')).html();
            $('.mobile-app-settings-alert').html('<div class="alert alert-' + (ok ? 'success' : 'danger') + '">' + message + '</div>');
        }).fail(function () {
            $('.mobile-app-settings-alert').html('<div class="alert alert-danger">Mobile settings could not be saved.</div>');
        }).always(function () {
            buttons.prop('disabled', false);
        });
    }
    $('[data-mobile-save]').on('click', submitMobileSettings);
});
</script>

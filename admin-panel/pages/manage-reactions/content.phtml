                <div class="modal-header">
                    <div>
                        <span class="ramza-reaction-kicker">Reaction settings</span>
                        <h5 class="modal-title">Edit reaction</h5>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <form class="edit_reaction_form" method="POST" enctype="multipart/form-data">
                        <div class="data_lang"></div>
                        <input type="hidden" name="hash_id" value="<?php echo Wo_CreateMainSession(); ?>">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="ramza-reaction-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="ramza-reaction-primary" id="save_edited_reaction">Save changes</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function ($) {
    'use strict';

    var requestUrl = Wo_Ajax_Requests_File() + '?f=admin_setting';
    var sessionHash = <?php echo json_encode(Wo_CreateMainSession()); ?>;
    var deleteId = 0;
    var noticeTimer = null;

    function showNotice(message, type) {
        var notice = $('#ramza-reaction-notice');
        window.clearTimeout(noticeTimer);
        notice.removeClass('is-success is-error is-visible')
            .addClass(type === 'error' ? 'is-error is-visible' : 'is-success is-visible')
            .text(message || (type === 'error' ? 'The change could not be saved.' : 'Saved.'));
        noticeTimer = window.setTimeout(function () {
            notice.removeClass('is-visible');
        }, 4200);
    }

    $('#ramza-icon').on('change', function () {
        var file = this.files && this.files[0] ? this.files[0] : null;
        $('#ramza-icon-name').text(file ? file.name : 'Choose icon');
        if (!file || !/^image\//.test(file.type)) {
            return;
        }
        var reader = new FileReader();
        reader.onload = function (event) {
            $('#ramza-add-icon-preview').html($('<img>', {src: event.target.result, alt: ''}));
        };
        reader.readAsDataURL(file);
    });

    var addForm = $('#add_reaction_form');
    addForm.ajaxForm({
        url: requestUrl + '&s=add_reaction',
        dataType: 'json',
        beforeSend: function () {
            addForm.find('button[type="submit"]').prop('disabled', true).text('Adding…');
        },
        success: function (data) {
            if (data && data.status === 200) {
                showNotice(data.message || 'Reaction added.', 'success');
                window.setTimeout(function () { window.location.reload(); }, 450);
            }
            else {
                showNotice(data && data.message ? data.message : '', 'error');
            }
        },
        error: function () { showNotice('The server did not accept the request.', 'error'); },
        complete: function () {
            addForm.find('button[type="submit"]').prop('disabled', false).text('Add reaction');
        }
    });

    $(document).on('click', '.js-reaction-toggle', function () {
        var button = $(this);
        button.prop('disabled', true);
        $.post(requestUrl + '&s=reaction_status', {id: button.data('id'), hash_id: sessionHash}, function (data) {
            if (data && data.status === 200) {
                var enabled = Number(data.enabled) === 1;
                button.attr('aria-checked', enabled ? 'true' : 'false').toggleClass('is-on', enabled);
                button.closest('.ramza-reaction-row').toggleClass('is-disabled', !enabled)
                    .find('.ramza-reaction-state').text(enabled ? 'Active' : 'Disabled');
                showNotice(data.message, 'success');
            }
            else {
                showNotice(data && data.message ? data.message : '', 'error');
            }
        }, 'json').fail(function () {
            showNotice('The server did not accept the request.', 'error');
        }).always(function () {
            button.prop('disabled', false);
        });
    });

    $(document).on('click', '.js-reaction-edit', function () {
        $.post(requestUrl + '&s=get_reaction_form', {id: $(this).data('id'), hash_id: sessionHash}, function (data) {
            if (data && data.status === 200) {
                $('#editReactionModal .data_lang').html(data.html);
                $('#editReactionModal').modal('show');
            }
            else {
                showNotice(data && data.message ? data.message : '', 'error');
            }
        }, 'json').fail(function () {
            showNotice('The reaction editor could not be opened.', 'error');
        });
    });

    $(document).on('click', '.js-reaction-delete', function () {
        deleteId = Number($(this).data('id')) || 0;
        $('#DeleteReactionModal').modal('show');
    });

    $('#ramza-confirm-delete').on('click', function () {
        var button = $(this);
        if (!deleteId) { return; }
        button.prop('disabled', true).text('Deleting…');
        $.post(requestUrl + '&s=delete_reaction', {id: deleteId, hash_id: sessionHash}, function (data) {
            if (data && data.status === 200) {
                $('#reaction-row-' + deleteId).slideUp(180, function () { $(this).remove(); });
                $('#DeleteReactionModal').modal('hide');
                showNotice(data.message, 'success');
            }
            else {
                showNotice(data && data.message ? data.message : '', 'error');
            }
        }, 'json').fail(function () {
            showNotice('The reaction could not be deleted.', 'error');
        }).always(function () {
            button.prop('disabled', false).text('Delete');
        });
    });

    var editForm = $('form.edit_reaction_form');
    editForm.ajaxForm({
        url: requestUrl + '&s=edit_reaction',
        dataType: 'json',
        beforeSend: function () {
            $('#save_edited_reaction').prop('disabled', true).text('Saving…');
        },
        success: function (data) {
            if (data && data.status === 200) {
                showNotice(data.message || 'Reaction updated.', 'success');
                $('#editReactionModal').modal('hide');
                window.setTimeout(function () { window.location.reload(); }, 450);
            }
            else {
                showNotice(data && data.message ? data.message : '', 'error');
            }
        },
        error: function () { showNotice('The server did not accept the request.', 'error'); },
        complete: function () {
            $('#save_edited_reaction').prop('disabled', false).text('Save changes');
        }
    });

    $('#save_edited_reaction').on('click', function () {
        editForm.submit();
    });
})(jQuery);
</script>

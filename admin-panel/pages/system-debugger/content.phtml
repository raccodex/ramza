<style>
.rac-diagnostic-switch{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px solid #e7e9ed}.rac-diagnostic-switch .form-group{margin:0}.rac-diagnostics-page .table th{width:34%;white-space:nowrap}.rac-diagnostics-page .btn{margin:4px 6px 0 0}.rac-feedback{margin-top:20px;padding-top:18px;border-top:1px solid #e7e9ed}.rac-feedback label{display:block;margin:12px 0 6px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.rac-feedback textarea{resize:vertical}
</style>
<script>
(function($){
  function notice(type,text){$('.diagnostics-alert').html('<div class="alert alert-'+type+'">'+$('<div>').text(text).html()+'</div>');}
  $('.diagnostics-settings-form').on('submit',function(e){e.preventDefault();var form=$(this);form.find('button').prop('disabled',true);$.post(Wo_Ajax_Requests_File()+'?f=admin_setting&s=update_general_setting',form.serialize(),function(data){notice(data.status==200?'success':'danger',data.message||'Settings saved.');},'json').fail(function(){notice('danger','Settings could not be saved.');}).always(function(){form.find('button').prop('disabled',false);});});
  $('#ramza-run-diagnostics,#ramza-send-diagnostics').on('click',function(){var action=this.id==='ramza-send-diagnostics'?'send':'collect';var button=$(this);button.prop('disabled',true);$.post(Wo_Ajax_Requests_File()+'?f=admin_setting&s=system_diagnostics',{hash_id:'<?php echo Wo_CreateSession(); ?>',action:action,feedback_subject:$('#ramza-feedback-subject').val(),feedback_message:$('#ramza-feedback-message').val()},function(data){notice(data.status==200?'success':'danger',data.message||'Diagnostic action completed.');if(action==='collect'&&data.status==200){setTimeout(function(){window.location.reload();},350);}if(action==='send'&&data.status==200){$('#ramza-feedback-subject,#ramza-feedback-message').val('');}},'json').fail(function(){notice('danger','Diagnostic action failed.');}).always(function(){button.prop('disabled',false);});});
})(jQuery);
</script>

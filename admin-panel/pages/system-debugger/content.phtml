<?php
$ramzaDiagnostics = function_exists('Ramza_DiagnosticsSnapshot') ? Ramza_DiagnosticsSnapshot(false) : array();
$ramzaDiagValue = static function ($key, $default = '') use ($wo) {
    return htmlspecialchars((string) ($wo['config'][$key] ?? $default), ENT_QUOTES, 'UTF-8');
};
$ramzaDiagChecked = static function ($key) use ($wo) {
    return !empty($wo['config'][$key]) ? 'checked' : '';
};
?>
<div class="container-fluid rac-diagnostics-page">
    <div class="block-header"><h2>System Debugger</h2></div>
    <div class="diagnostics-alert"></div>
    <div class="row">
        <div class="col-xl-7 col-lg-7 col-md-12">
            <div class="card"><div class="card-body">
                <h6 class="card-title">Runtime scan</h6>
                <div class="table-responsive"><table class="table table-hover">
                    <tbody>
                    <?php
                    $rows = array(
                        'PHP' => $ramzaDiagnostics['runtime']['php'] ?? 'Unknown',
                        'Database' => $ramzaDiagnostics['runtime']['database'] ?? 'Unknown',
                        'FFmpeg' => !empty($ramzaDiagnostics['media']['ffmpeg_available']) ? 'Ready' : ($ramzaDiagnostics['media']['ffmpeg_message'] ?? 'Unavailable'),
                        'Remote storage' => !empty($ramzaDiagnostics['media']['remote_storage']) ? 'Enabled' : 'Local storage',
                        'Call provider' => str_replace('_', ' ', $ramzaDiagnostics['realtime']['call_provider'] ?? 'disabled'),
                        'Live provider' => str_replace('_', ' ', $ramzaDiagnostics['realtime']['live_provider'] ?? 'disabled'),
                        'TURN relay' => ($ramzaDiagnostics['realtime']['turn_mode'] ?? 'disabled') . (!empty($ramzaDiagnostics['realtime']['turn_host']) ? ' · ' . $ramzaDiagnostics['realtime']['turn_host'] : ''),
                    );
                    foreach ($rows as $label => $value) { ?>
                        <tr><th><?php echo htmlspecialchars($label, ENT_QUOTES, 'UTF-8'); ?></th><td><?php echo htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); ?></td></tr>

                <h6 class="card-title">Developer reporting</h6>
                <form class="diagnostics-settings-form" method="POST">
                    <input type="hidden" name="hash_id" value="<?php echo Wo_CreateSession(); ?>">
                    <?php foreach (array('diagnostic_reporting_system' => 'Enable reporting', 'diagnostic_auto_send' => 'Automatic reports', 'diagnostic_include_logs' => 'Include redacted log excerpts') as $key => $label) { ?>
                        <div class="rac-diagnostic-switch"><span><?php echo $label; ?></span><div class="form-group switcher"><input type="hidden" name="<?php echo $key; ?>" value="0"><input type="checkbox" id="<?php echo $key; ?>" name="<?php echo $key; ?>" value="1" <?php echo $ramzaDiagChecked($key); ?>><label for="<?php echo $key; ?>" class="check-trail"><span class="check-handler"></span></label></div></div>
                    <?php } ?>
                    <div class="form-group"><label>Portal endpoint</label><input class="form-control" type="url" name="developer_portal_url" placeholder="https://developer.example.com/ramza-developer-portal.php" value="<?php echo $ramzaDiagValue('developer_portal_url'); ?>"></div>
                    <div class="form-group"><label>Portal token</label><input class="form-control" type="password" name="developer_portal_token" autocomplete="new-password" value="<?php echo $ramzaDiagValue('developer_portal_token'); ?>"></div>

                    </tbody>
                </table></div>
                <button type="button" class="btn btn-outline-primary" id="ramza-run-diagnostics">Refresh scan</button>
                <div class="rac-feedback">
                    <label>Subject</label><input class="form-control" id="ramza-feedback-subject" maxlength="120" placeholder="Short summary">
                    <label>Feedback</label><textarea class="form-control" id="ramza-feedback-message" maxlength="4000" rows="4" placeholder="Describe the issue or request"></textarea>
                    <button type="button" class="btn btn-primary" id="ramza-send-diagnostics">Send to developer portal</button>

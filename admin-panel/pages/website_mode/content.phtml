<?php
$rac_current_version = (string)($wo['config']['version'] ?? '1.0');
$rac_future_website_modes = array(
    'twitter' => '2.0',
    'askfm' => '2.5',
    'tiktok' => '3.0',
);
$rac_is_website_mode_locked = static function (string $mode) use ($rac_current_version, $rac_future_website_modes): bool {
    return isset($rac_future_website_modes[$mode]) && version_compare($rac_current_version, $rac_future_website_modes[$mode], '<');
};
$rac_mode_card_class = static function (string $mode) use ($rac_is_website_mode_locked): string {
    return $rac_is_website_mode_locked($mode) ? 'rac-mode-card rac-mode-card--upcoming rac-mode-card--locked' : 'rac-mode-card';
};
$rac_mode_checked_attr = static function (string $mode) use ($wo, $rac_is_website_mode_locked): string {
    return (!$rac_is_website_mode_locked($mode) && $wo['config']['website_mode'] === $mode) ? 'checked' : '';
};
$rac_mode_disabled_attr = static function (string $mode) use ($rac_is_website_mode_locked, $rac_future_website_modes): string {
    if (!$rac_is_website_mode_locked($mode)) {
        return '';
    }
    $required_version = htmlspecialchars($rac_future_website_modes[$mode], ENT_QUOTES, 'UTF-8');
    return 'disabled aria-disabled="true" data-mode-locked="1" data-required-version="' . $required_version . '"';
};
$rac_mode_lock_notice = static function (string $mode) use ($rac_is_website_mode_locked, $rac_future_website_modes, $rac_current_version): string {
    if (!$rac_is_website_mode_locked($mode)) {
        return '';
    }
    $required_version = htmlspecialchars($rac_future_website_modes[$mode], ENT_QUOTES, 'UTF-8');
    $current_version = htmlspecialchars($rac_current_version, ENT_QUOTES, 'UTF-8');
    return '<div class="rac-mode-lock-note">Available in RACSocial v' . $required_version . '. Current version is v' . $current_version . '.</div>';
};

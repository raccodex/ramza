<script>

$(function() {
    var form_add_settings = $('form.add-settings');
    var save_button = form_add_settings.find('button[type="submit"]');
    var syncEmailEditors = function() {
        if (!window.tinymce) {
            return;
        }
        form_add_settings.find('textarea[id]').each(function() {
            var editor = tinymce.get(this.id);
            if (editor) {
                var content = editor.getContent({format: 'html'});
                this.value = content;
                $(this).val(content);
            }
        });
    };
    var encodeTemplatePayload = function() {
        var payload = {
            hash_id: form_add_settings.find('input[name="hash_id"]').val(),
            template_encoding: 'base64'
        };
        form_add_settings.find('textarea[name]').each(function() {
            payload[this.name] = window.btoa(unescape(encodeURIComponent(this.value || '')));
        });
        return payload;
    };
    form_add_settings.off('submit.ramzaEmailTemplates').on('submit.ramzaEmailTemplates', function(event) {
        event.preventDefault();
        event.stopImmediatePropagation();
        syncEmailEditors();
        var templatePayload;
        try {
            templatePayload = encodeTemplatePayload();
        } catch (encodingError) {
            $('.add-settings-alert').html('<div class="alert alert-danger">The template contains text that could not be prepared for saving.</div>');
            return;
        }
        save_button.prop('disabled', true).text('Please wait..');
        $.ajax({
            url: Wo_Ajax_Requests_File() + '?f=admin_setting&s=update_html_emails',
            type: 'POST',
            data: templatePayload,
            dataType: 'json',
            timeout: 60000
        }).done(function(data) {
            if (data && Number(data.status) === 200) {
                $("html, body").animate({scrollTop: 0}, "slow");
                $('.add-settings-alert').html('<div class="alert alert-success"><i class="fa fa-check"></i> '+(data.message || 'Email templates saved successfully.')+'</div>');
                return;
            }
            var responseMessage = data && data.message ? data.message : 'Email templates could not be saved.';
            $('.add-settings-alert').html('<div class="alert alert-danger">'+$('<div>').text(responseMessage).html()+'</div>');
        }).fail(function(xhr, status) {
            var message = 'Email templates could not be saved.';
            if (xhr.responseJSON && xhr.responseJSON.message) {
                message = xhr.responseJSON.message;
            } else if (status === 'timeout') {
                message = 'The save request timed out. Please try again.';
            } else if (Number(xhr.status) === 403) {
                message = 'The server security firewall rejected the save request (HTTP 403).';
            } else if (Number(xhr.status) === 413) {
                message = 'The email templates exceed the server request-size limit (HTTP 413).';
            } else if (xhr.status) {
                message = 'The server could not save the templates (HTTP '+xhr.status+').';
            }
            $('.add-settings-alert').html('<div class="alert alert-danger">'+$('<div>').text(message).html()+'</div>');
        }).always(function() {
            save_button.prop('disabled', false).text(save_button.data('label') || 'Save');
        });
    });

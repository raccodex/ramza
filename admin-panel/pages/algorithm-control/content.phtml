<script>
$(function () {
    $('[data-algorithm-tab]').on('click', function () {
        var selected = String($(this).data('algorithm-tab') || 'essentials');
        $('[data-algorithm-tab]').each(function () {
            var active = String($(this).data('algorithm-tab')) === selected;
            $(this).toggleClass('is-active', active).attr('aria-selected', active ? 'true' : 'false');
        });
        $('[data-algorithm-panel]').each(function () {
            var active = String($(this).data('algorithm-panel')) === selected;
            $(this).toggleClass('is-active', active).prop('hidden', !active);
        });
    });

    $('[data-rac-range]').on('input change', function () {
        $('[data-rac-range-output="' + $(this).data('rac-range') + '"]').text($(this).val() + '%');
    });

    $('.rac-algorithm-settings').on('submit', function (event) {
        event.preventDefault();
        var form = $(this);
        var button = form.find('.rac-algorithm-save');
        var originalText = button.text();

        button.prop('disabled', true).text('Saving...');
        $('.algorithm-settings-alert').html('');

        $.post(Wo_Ajax_Requests_File() + '?f=admin_setting&s=update_general_setting', form.serialize(), function (data) {
            if (data.status == 200) {
                $('.algorithm-settings-alert').html('<div class="alert alert-success">Algorithm control settings saved. Home feed ranking will use the updated signal weights.</div>');
            } else {
                $('.algorithm-settings-alert').html('<div class="alert alert-danger">' + (data.message || 'Settings could not be saved.') + '</div>');
            }
            button.prop('disabled', false).text(originalText);
        });
    });

    $('.rac-algorithm-maintenance').on('click', function () {
        var button = $(this);
        var label = button.text();
        button.prop('disabled', true).text('Running...');
        $.post(Wo_Ajax_Requests_File() + '?f=algorithm&s=run_maintenance', {hash_id: '<?php echo Wo_CreateSession(); ?>'}, function (data) {
            if (data && data.status == 200 && data.data) {
                $('.algorithm-settings-alert').html('<div class="alert alert-success">Maintenance completed. Indexed ' + (data.data.indexed || 0) + ', processed ' + (data.data.aggregated || 0) + ' events.</div>');
                window.setTimeout(function () { window.location.reload(); }, 700);
            } else {
                $('.algorithm-settings-alert').html('<div class="alert alert-danger">Maintenance could not be completed.</div>');
            }
        }, 'json').always(function () {
            button.prop('disabled', false).text(label);
        });
    });

    $('.rac-algorithm-debug').on('click', function () {
        var userId = parseInt($('[data-algorithm-debug-user]').val(), 10) || 0;
        var result = $('.rac-algorithm-debug-result');
        if (userId < 1) {
            result.html('<p class="rac-debug-empty">Enter a user ID.</p>');
            return;
        }
        result.html('<p class="rac-debug-empty">Loading...</p>');
        $.post(Wo_Ajax_Requests_File() + '?f=algorithm&s=debug_user', {hash_id: '<?php echo Wo_CreateSession(); ?>', user_id: userId}, function (data) {
            if (!data || data.status != 200 || !data.data) {
                result.html('<p class="rac-debug-empty">No ranking data found.</p>');
                return;
            }
            var escapeHtml = function (value) { return $('<div>').text(value == null ? '' : value).html(); };
            var html = '<div class="rac-debug-section"><h4>Learned topics</h4><div class="rac-debug-list">';
            (data.data.interests || []).forEach(function (item) {
                html += '<div><span>' + escapeHtml(item.name || item.slug || ('Topic ' + item.topic_id)) + '</span><strong>' + escapeHtml(item.score) + '</strong></div>';
            });
            html += '</div></div>';
            if (!(data.data.interests || []).length) {
                html = '<div class="rac-debug-section"><h4>Learned topics</h4><p class="rac-debug-empty">No learned topics yet.</p></div>';
            }
            html += '<div class="rac-debug-section"><h4>Recent ranking examples</h4><div class="rac-debug-list">';
            (data.data.ranked_examples || []).forEach(function (item) {
                var details = item.breakdown || {};
                var summary = 'Post ' + item.post_id + ' · ' + (item.pool || 'relevant') + ' · ' + (item.reason || 'ranked');
                var score = 'Score ' + item.score + ' (topic ' + (details.topic || 0) + ', related ' + (details.related || 0) + ', quality ' + (details.quality || 0) + ')';
                html += '<div><span>' + escapeHtml(summary) + '</span><strong>' + escapeHtml(score) + '</strong></div>';
            });
            html += '</div></div>';
            if (!(data.data.ranked_examples || []).length) {
                html += '<p class="rac-debug-empty">No recent ranked posts.</p>';
            }
            result.html(html);
        }, 'json');
    });

    var algorithmActionUrl = function (action) {
        return Wo_Ajax_Requests_File() + '?f=algorithm&s=' + encodeURIComponent(action);
    };
    var showAlgorithmMessage = function (ok, message) {
        $('.algorithm-settings-alert').html('<div class="alert alert-' + (ok ? 'success' : 'danger') + '">' + $('<div>').text(message || (ok ? 'Algorithm data updated.' : 'The action failed.')).html() + '</div>');
        window.scrollTo({top: 0, behavior: 'smooth'});
    };

    $('.rac-algorithm-action').on('submit', function (event) {
        event.preventDefault();
        var form = $(this);
        var action = form.data('algorithm-action');
        var button = form.find('[type="submit"]');
        button.prop('disabled', true);
        $.post(algorithmActionUrl(action), form.serialize(), function (data) {
            if (data && data.status == 200) {
                showAlgorithmMessage(true, data.message);
                window.setTimeout(function () { window.location.reload(); }, 500);
            } else {
                showAlgorithmMessage(false, data && data.message);
            }
        }, 'json').fail(function (xhr) {
            var data = xhr.responseJSON || {};
            showAlgorithmMessage(false, data.message || 'The algorithm action failed.');
        }).always(function () {
            button.prop('disabled', false);
        });
    });

    $('.rac-topic-edit').on('click', function () {
        var topic = $(this).data('topic') || {};
        var form = $('.rac-topic-form');
        form.find('[name="topic_id"]').val(topic.id || 0);
        form.find('[name="name"]').val(topic.name || '');
        form.find('[name="slug"]').val(topic.slug || '');
        form.find('[name="topic_type"]').val(topic.topic_type || 'topic');
        form.find('[name="language"]').val(topic.language || 'und');
        form.find('[name="aliases"]').val(topic.aliases || '');
        form.find('[name="status"]').prop('checked', !!parseInt(topic.status, 10));
        form.get(0).scrollIntoView({behavior: 'smooth', block: 'center'});
    });
    $('.rac-topic-clear').on('click', function () {
        var form = $('.rac-topic-form').get(0);
        if (form) {
            form.reset();
            $(form).find('[name="topic_id"]').val(0);
        }
    });
    $('.rac-topic-status').on('click', function () {
        $.post(algorithmActionUrl('set_topic_status'), {hash_id: '<?php echo Wo_CreateSession(); ?>', topic_id: $(this).data('id'), enabled: $(this).data('enabled')}, function (data) {
            if (data && data.status == 200) {
                window.location.reload();
            } else {
                showAlgorithmMessage(false, data && data.message);
            }
        }, 'json');
    });
    $('.rac-algorithm-delete').on('click', function () {
        if (!window.confirm('Remove this algorithm item?')) {
            return;
        }
        var payload = {hash_id: '<?php echo Wo_CreateSession(); ?>'};
        payload[$(this).data('key')] = $(this).data('id');
        $.post(algorithmActionUrl($(this).data('action')), payload, function (data) {
            if (data && data.status == 200) {
                window.location.reload();
            } else {
                showAlgorithmMessage(false, data && data.message);
            }
        }, 'json');
    });
});
</script>

<script type="text/javascript">
	<?php 
$js_array = json_encode($wo['group_sub_categories']);
echo "var sub_categories_array = ". $js_array . ";\n";
?>
	function GetGroupSubCategory(self) {
		var id = $(self).val();
		var text = "";
		if (typeof(sub_categories_array[id]) == 'undefined') {
		    $('#group_sub_category').html('');
		}
		else{
		   	sub_categories_array[id].forEach(function(entry) {
				text = text + "<option value='"+entry.id+"'>"+entry.lang+"</option>";
			});
		    $('#group_sub_category').html(text);
		}
	}
	window.RamzaCommunitySlug = window.RamzaCommunitySlug || function(value) {
		return String(value || '').toLowerCase().trim().replace(/[\s-]+/g, '_').replace(/[^a-z0-9_]/g, '').replace(/_+/g, '_').replace(/^_+|_+$/g, '').slice(0, 32);
	};
	window.RamzaBindGroupForm = window.RamzaBindGroupForm || function($form) {
		if (!$form.length || $form.data('ramza-bound')) { return; }
		$form.data('ramza-bound', true);
		var $title = $form.find('[name="group_title"]');
		var $slug = $form.find('[name="group_name"]');
		var slugWasEdited = false;
		function updatePreview() {
			$form.find('.group-url-preview').text(<?php echo json_encode(rtrim($wo['config']['site_url'], '/') . '/'); ?> + $slug.val());
		}
		function showErrors(payload) {
			var errors = payload && $.isArray(payload.errors) ? payload.errors : [payload && (payload.error || payload.message) ? (payload.error || payload.message) : 'Unable to create the group. Please try again.'];
			var $alert = $('<div class="alert alert-danger" role="alert"></div>');
			$.each(errors, function(_, error) { $('<div></div>').text($('<div></div>').html(String(error)).text()).appendTo($alert); });
			$form.find('.app-general-alert').empty().append($alert);
		}
		$title.on('input.ramzaGroupSlug', function() {
			if (!slugWasEdited) { $slug.val(window.RamzaCommunitySlug(this.value)); updatePreview(); }
		});
		$slug.on('input.ramzaGroupSlug', function() { slugWasEdited = true; this.value = window.RamzaCommunitySlug(this.value); updatePreview(); });
		updatePreview();
		$form.on('submit.ramzaCreateGroup', function(event) {
			event.preventDefault();
			$slug.val(window.RamzaCommunitySlug($slug.val()));
			var $buttons = $form.find('.disable_btn');
			$buttons.prop('disabled', true);
			$form.find('.app-general-alert').empty();
			$.ajax({ url: Wo_Ajax_Requests_File() + '?f=groups&s=create_group', type: 'POST', dataType: 'json', data: $form.serialize() })
			.done(function(data) {
				if (data && Number(data.status) === 200 && data.location) { window.location.href = data.location; return; }
				showErrors(data || {});
			}).fail(function(xhr) { showErrors(xhr.responseJSON || {}); })
			.always(function() { $buttons.prop('disabled', false); if (typeof scrollToTop === 'function') { scrollToTop(); } });
		});
	};
	$(function() { window.RamzaBindGroupForm($('form.create-group-form')); });
</script>

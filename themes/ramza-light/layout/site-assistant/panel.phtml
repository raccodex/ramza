                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="m3.4 20.4 17.45-7.48c.76-.33.76-1.4 0-1.73L3.4 3.6c-.62-.27-1.3.2-1.21.87l.8 5.82 9.51 1.77-9.51 1.65-.8 5.82c-.09.67.59 1.14 1.21.87Z"/></svg>
            </button>
        </form>
    </footer>
</section>

<script>
(function($) {
    'use strict';
    var hash = <?php echo json_encode($assistantHash); ?>;
    var shell = $('#ramza-assistant-shell');
    var feed = $('#ramza-assistant-feed');
    var command = $('#ramza-assistant-command');
    var send = $('#ramza-assistant-send');

    function openPanel() {
        shell.addClass('is-open');
        $('#ramza-assistant-launcher').attr('aria-expanded', 'true');
        window.setTimeout(function() { command.trigger('focus'); }, 60);
    }
    function closePanel() {
        shell.removeClass('is-open');
        $('#ramza-assistant-launcher').attr('aria-expanded', 'false').trigger('focus');
    }
    function scrollFeed() { feed.stop().animate({scrollTop: feed[0].scrollHeight}, 150); }
    function message(text, type) {
        $('<div>', {'class':'ramza-assistant-message' + (type ? ' is-' + type : '')}).text(text || '').appendTo(feed);
        scrollFeed();
    }
    function busy(state) { send.prop('disabled', state); command.prop('disabled', state); }
    function request(action, payload) {
        payload = payload || {};
        payload.hash_id = hash;
        busy(true);
        return $.ajax({url: Wo_Ajax_Requests_File() + '?f=site_assistant&s=' + encodeURIComponent(action), method:'POST', dataType:'json', data:payload})
            .fail(function(xhr) {
                var data = xhr.responseJSON || {};
                message(data.message || 'The assistant is unavailable.', 'error');
            }).always(function() { busy(false); });
    }
    function recordLink(item) {
        var link = $('<a>', {'class':'ramza-assistant-record', href:item.url || '#'});
        if (item.url) { link.attr({target:'_self', rel:'noopener'}); }
        $('<strong>').text(item.title || item.name || item.username || 'Result').appendTo(link);
        if (item.summary || item.text || item.username) {
            $('<span>').text(item.summary || item.text || (item.username ? '@' + item.username : '')).appendTo(link);
        }
        return link;
    }
    function prepare(intent, userId, extra) {
        var data = $.extend({intent:intent, user_id:userId}, extra || {});
        request('prepare', data).done(function(response) { if (response.ok) render(response.data); });
    }
    function showReactionPicker(userId) {
        var wrap = $('<div>', {'class':'ramza-assistant-reactions'}).appendTo(feed);
        $.each({'1':'Like','2':'Love','3':'Haha','4':'Wow','5':'Sad','6':'Angry'}, function(value, label) {
            $('<button>', {type:'button'}).text(label).on('click', function() { wrap.remove(); prepare('reaction', userId, {reaction:value}); }).appendTo(wrap);
        });
        scrollFeed();
    }
    function render(data) {
        if (!data || !data.kind) { message('No result was returned.', 'error'); return; }
        if (data.kind === 'message') { message(data.message || 'Done.'); return; }
        if (data.kind === 'users') {
            message(data.message || 'Choose a user');
            var list = $('<div>', {'class':'ramza-assistant-list'}).appendTo(feed);
            $.each(data.users || [], function(_, user) {
                var button = $('<button>', {type:'button','class':'ramza-assistant-choice'});
                $('<img>', {src:user.avatar || '', alt:''}).appendTo(button);
                var copy = $('<span>').appendTo(button);
                $('<strong>').text(user.name || user.username).appendTo(copy);
                $('<small>').text('@' + user.username).appendTo(copy);
                button.on('click', function() {
                    list.remove();
                    if (data.intent === 'reaction') { showReactionPicker(user.id); }
                    else { prepare(data.intent, user.id); }
                }).appendTo(list);
            });
            scrollFeed(); return;
        }
        if (data.kind === 'results') {
            message(data.message || 'Public results');
            var results = $('<div>', {'class':'ramza-assistant-list'}).appendTo(feed);
            $.each(data.results || {}, function(_, items) { $.each(items || [], function(__, item) { recordLink(item).appendTo(results); }); });
            if (!results.children().length) { results.remove(); message('No matching public records were found.'); }
            scrollFeed(); return;
        }
        if (data.kind === 'post') {
            var post = $.extend({title:(data.user && data.user.name ? data.user.name + ' · latest post' : 'Latest post')}, data.post || {});
            recordLink(post).appendTo(feed); scrollFeed(); return;
        }
        if (data.kind === 'input') {
            var card = $('<div>', {'class':'ramza-assistant-input-card'}).appendTo(feed);
            $('<textarea>', {maxlength:1000, placeholder:data.message || 'Write a comment'}).appendTo(card);
            $('<button>', {type:'button'}).text('Continue').on('click', function() {
                var text = card.find('textarea').val();
                if (!$.trim(text)) { card.find('textarea').trigger('focus'); return; }
                card.remove(); prepare(data.intent, data.user_id, {text:text});
            }).appendTo(card);
            scrollFeed(); return;
        }
        if (data.kind === 'draft') {
            var draft = $('<div>', {'class':'ramza-assistant-confirm'}).appendTo(feed);
            $('<strong>').text(data.title || 'Blog draft').appendTo(draft);
            if (data.description) { $('<div>', {'class':'ramza-assistant-preview'}).text(data.description).appendTo(draft); }
            if (data.content) { $('<div>', {'class':'ramza-assistant-preview'}).text(data.content).appendTo(draft); }
            if (data.tags) { $('<div>', {'class':'ramza-assistant-preview'}).text('Tags: ' + data.tags).appendTo(draft); }
            if (data.editor_url) {
                $('<a>', {'class':'ramza-assistant-record', href:data.editor_url}).text('Open blog editor').appendTo(draft);
            }
            scrollFeed(); return;
        }
        if (data.kind === 'confirm') {
            var box = $('<div>', {'class':'ramza-assistant-confirm'}).appendTo(feed);
            $('<strong>').text(data.summary || 'Confirm action').appendTo(box);
            if (data.preview) { $('<div>', {'class':'ramza-assistant-preview'}).text(data.preview).appendTo(box); }
            var actions = $('<div>', {'class':'ramza-assistant-actions'}).appendTo(box);
            $('<button>', {type:'button','class':'ramza-assistant-cancel'}).text('Cancel').on('click', function() { box.remove(); message('Cancelled.'); }).appendTo(actions);
            $('<button>', {type:'button','class':'ramza-assistant-confirm-button'}).text('Confirm').on('click', function() {
                var confirmButton = $(this).prop('disabled', true);
                request('execute', {token:data.token}).done(function(response) {
                    if (response.ok) {
                        box.remove();
                        var done = $('<div>', {'class':'ramza-assistant-message'}).text(response.message || 'Done.').appendTo(feed);
                        if (response.location) { $('<a>', {href:response.location}).text(' View').appendTo(done); }
                        scrollFeed();
                    } else { confirmButton.prop('disabled', false); }
                });
            }).appendTo(actions);
            scrollFeed();
        }
    }

    $('#ramza-assistant-launcher').on('click', function() { shell.hasClass('is-open') ? closePanel() : openPanel(); });
    $('#ramza-assistant-close').on('click', closePanel);
    $(document).on('keydown.ramzaAssistant', function(event) { if (event.key === 'Escape' && shell.hasClass('is-open')) { closePanel(); } });
    $('#ramza-assistant-form').on('submit', function(event) {
        event.preventDefault();
        var text = $.trim(command.val());
        if (!text) { command.trigger('focus'); return; }
        message(text, 'user'); command.val('');
        request('plan', {command:text}).done(function(response) { if (response.ok) { render(response.data); } });
    });
})(jQuery);
</script>

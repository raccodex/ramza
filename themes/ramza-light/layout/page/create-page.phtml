<script type="text/javascript">
	<?php
$js_array = json_encode($wo['page_sub_categories']);
echo "var sub_categories_array = ". $js_array . ";\n";
?>
	function GetPageSubCategory(self) {
		var id = $(self).val();
		var text = "";
		if (typeof(sub_categories_array[id]) == 'undefined') {
		    $('#page_sub_category').html('');
		}
		else{
		   	sub_categories_array[id].forEach(function(entry) {
				text = text + "<option value='"+entry.id+"'>"+entry.lang+"</option>";
			});
		    $('#page_sub_category').html(text);
		}
	}
	window.RamzaCommunitySlug = window.RamzaCommunitySlug || function(value) {
		return String(value || '').toLowerCase().trim().replace(/[\s-]+/g, '_').replace(/[^a-z0-9_]/g, '').replace(/_+/g, '_').replace(/^_+|_+$/g, '').slice(0, 32);
	};
	$(function() {
		var $form = $('form.create-page-form');
		var $title = $form.find('[name="page_title"]');
		var $slug = $form.find('[name="page_name"]');
		var slugWasEdited = false;
		function updatePreview() {
			$('#page-url-preview').text(<?php echo json_encode(rtrim($wo['config']['site_url'], '/') . '/'); ?> + $slug.val());
		}
		function showErrors(payload) {
			var errors = payload && $.isArray(payload.errors) ? payload.errors : [payload && (payload.error || payload.message) ? (payload.error || payload.message) : 'Unable to create the page. Please try again.'];
			var $alert = $('<div class="alert alert-danger" role="alert"></div>');
			$.each(errors, function(_, error) {
				$('<div></div>').text($('<div></div>').html(String(error)).text()).appendTo($alert);
			});
			$form.find('.app-general-alert').empty().append($alert);
		}
		$title.on('input.ramzaPageSlug', function() {
			if (!slugWasEdited) {
				$slug.val(window.RamzaCommunitySlug(this.value));
				updatePreview();
			}
		});
		$slug.on('input.ramzaPageSlug', function() {
			slugWasEdited = true;
			this.value = window.RamzaCommunitySlug(this.value);
			updatePreview();
		}).on('blur.ramzaPageSlug', function() {
			this.value = window.RamzaCommunitySlug(this.value);
			updatePreview();
		});
		updatePreview();
		$form.off('submit.ramzaCreatePage').on('submit.ramzaCreatePage', function(event) {
			event.preventDefault();
			$slug.val(window.RamzaCommunitySlug($slug.val()));
			var $buttons = $form.find('.disable_btn');
			$buttons.prop('disabled', true);
			$form.find('.app-general-alert').empty();
			$.ajax({
				url: Wo_Ajax_Requests_File() + '?f=pages&s=create_page',
				type: 'POST',
				dataType: 'json',
				data: $form.serialize()
			}).done(function(data) {
				if (data && Number(data.status) === 200 && data.location) {
					window.location.href = data.location;
					return;
				}
				showErrors(data || {});
			}).fail(function(xhr) {
				showErrors(xhr.responseJSON || {});
			}).always(function() {
				$buttons.prop('disabled', false);
				if (typeof scrollToTop === 'function') { scrollToTop(); }
			});
		});
	});
</script>

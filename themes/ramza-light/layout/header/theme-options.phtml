		<?php if (!mysqli_query($wo['sqlConnect'], "DESCRIBE `" . T_THEME_SETTINGS . "`" )) { ?>
		<?php } else { ?>
			$(function() {
				var changedThemeOption = null;
				var themeOptionSaving = false;
				var showThemeOptionError = function(message) {
					var alert = $('<div>', {'class': 'alert alert-danger', 'role': 'alert'}).text(message);
					$('.ramza_light_alert').empty().append(alert);
				};
				$('.tag_theme_opts_check input[type="checkbox"]').change(function(){
					if (themeOptionSaving) {
						this.checked = !this.checked;
						return;
					}
					changedThemeOption = this;
					$('form.ramza_light_form').submit();
				});
				$('form.ramza_light_form').ajaxForm({
					url: Wo_Ajax_Requests_File() + '?f=ramza_theme_settings&s=update',
					dataType: 'json',
					beforeSend: function() {
						themeOptionSaving = true;
						$('.ramza_light_alert').empty();
						$('.tag_theme_opts_check input[type="checkbox"]').prop('disabled', true);
					},
					success: function(data) {
						if (data && Number(data.status) === 200) {
							$("body").snackbar({
								message: data.message || 'Theme option saved.'
							});
							changedThemeOption = null;
						} else {
							if (changedThemeOption) {
								changedThemeOption.checked = !changedThemeOption.checked;
							}
							showThemeOptionError((data && (data.error || data.message)) || 'Unable to save the theme option. Please refresh and try again.');
						}
					},
					error: function(xhr) {
						if (changedThemeOption) {
							changedThemeOption.checked = !changedThemeOption.checked;
						}
						var response = xhr && xhr.responseJSON ? xhr.responseJSON : null;
						showThemeOptionError((response && (response.error || response.message)) || 'Unable to save the theme option. Please refresh and try again.');
					},
					complete: function() {
						themeOptionSaving = false;
						$('.tag_theme_opts_check input[type="checkbox"]').prop('disabled', false);
					}
				});
			});
		<?php } ?>
	</script>
<?php } ?>

<script>
(function () {
    var registerServiceWorker = function () {
        if (!('serviceWorker' in navigator)) {
            return;
        }
        window.addEventListener('load', function () {
            navigator.serviceWorker.register(<?php echo json_encode($ramzaPwaSiteUrl . '/pwa-service-worker.js.php', JSON_UNESCAPED_SLASHES); ?>, {
                scope: <?php echo json_encode($ramzaPwaScopePath, JSON_UNESCAPED_SLASHES); ?>
            }).catch(function () {});
        });
    };

    registerServiceWorker();

    var banner = document.querySelector('[data-ramza-pwa-banner]');
    if (!banner) {
        return;
    }

    var dismissKey = 'ramza_pwa_install_dismissed_until';
    var oneWeek = 7 * 24 * 60 * 60 * 1000;
    var deferredPrompt = null;
    var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    var dismissedUntil = parseInt(localStorage.getItem(dismissKey) || '0', 10);

    if (isStandalone || Date.now() < dismissedUntil) {
        return;
    }

    var showBanner = function () {
        banner.classList.add('is-visible');
    };

    var hideBanner = function () {
        banner.classList.remove('is-visible');
    };

    window.addEventListener('beforeinstallprompt', function (event) {
        event.preventDefault();
        deferredPrompt = event;
        showBanner();
    });

    window.addEventListener('appinstalled', function () {
        localStorage.setItem(dismissKey, String(Date.now() + oneWeek));
        hideBanner();
    });

    setTimeout(function () {
        if (!deferredPrompt && !isStandalone) {
            showBanner();
        }
    }, 1400);

    var closeButton = banner.querySelector('[data-ramza-pwa-close]');
    if (closeButton) {
        closeButton.addEventListener('click', function () {
            localStorage.setItem(dismissKey, String(Date.now() + oneWeek));
            hideBanner();
        });
    }

    var installButton = banner.querySelector('[data-ramza-pwa-install]');
    var hint = banner.querySelector('[data-ramza-pwa-hint]');
    if (installButton) {
        installButton.addEventListener('click', function () {
            if (!deferredPrompt) {
                if (hint) {
                    hint.textContent = 'If no prompt appears, use your browser menu and choose Add to Home screen.';
                }
                return;
            }
            deferredPrompt.prompt();
            deferredPrompt.userChoice.finally(function () {
                deferredPrompt = null;
                localStorage.setItem(dismissKey, String(Date.now() + oneWeek));
                hideBanner();
            });
        });
    }
})();
</script>

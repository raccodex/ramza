<script>
var working = false;
var $this = $('#register');
var $state = $this.find('.errors');
var $login_anim = $('.tag_auth_animation');

$(function() {
	$this.ajaxForm({
		url: Wo_Ajax_Requests_File() + '?f=register',
		beforeSend: function() {
			<?php if ($wo['config']['password_complexity_system'] == 1) { ?>
				if ($('.helper-text .length').hasClass('valid') && $('.helper-text .lowercase').hasClass('valid') && $('.helper-text .uppercase').hasClass('valid') && $('.helper-text .special').hasClass('valid')) {
					working = true;
					var $btn = $this.find('#sign_submit');
					$btn.attr("disabled", true);
					$btn.find('.btn_text').html('<span class="tag_btn_spinner"></span> <?php echo $wo['lang']['please_wait'] ?? "Please wait..."; ?>');
				}
				else{
					$state.html("<?php echo($wo['lang']['complexity_requirements']) ?>");
					$state.show();
					return false;
				}
			<?php } else{ ?>
				working = true;
				var $btn = $this.find('#sign_submit');
				$btn.attr("disabled", true);
				$btn.find('.btn_text').html('<span class="tag_btn_spinner"></span> <?php echo $wo['lang']['please_wait'] ?? "Please wait..."; ?>');
			<?php } ?>
		},
		success: function(data) {
			if (data.status == 200) {
				$login_anim.removeClass('d-none');
				setTimeout(function () {
					window.location.href = data.location;
				}, 1000);
			} else if (data.status == 300) {
				window.location.href = data.location;
			} else {
				$this.find('#sign_submit').attr("disabled", false);
				$this.find('#sign_submit .btn_text').text('<?php echo $wo['lang']['lets_go']?>');
				$state.html(data.errors);
				$state.show();
			} 
			working = false;
		}
	});
});

function activateButton(element) {
	if(element.checked) {
		document.getElementById("sign_submit").disabled = false;
	}
	else  {
		document.getElementById("sign_submit").disabled = true;
	}
};

<?php if ($wo['config']['password_complexity_system'] == 1) { ?>
(function(){
	var helperText = {
		charLength: document.querySelector('.helper-text .length'),
		lowercase: document.querySelector('.helper-text .lowercase'),
		uppercase: document.querySelector('.helper-text .uppercase'),
		special: document.querySelector('.helper-text .special')
	};
	var password = document.querySelector('#password');
	var pattern = {
		charLength: function() {
			if( password && password.value.length >= 6 ) {
				return true;
			}
		},
		lowercase: function() {
			var regex = /^(?=.*[a-z]).+$/;
			if( password && regex.test(password.value) ) {
				return true;
			}
		},
		uppercase: function() {
			var regex = /^(?=.*[A-Z]).+$/;
			if( password && regex.test(password.value) ) {
				return true;
			}
		},
		special: function() {
			var regex = /^(?=.*[0-9_\W]).+$/;
			if( password && regex.test(password.value) ) {
				return true;
			}
		}   
	};
	function CheckCPassword() {
		$('.helper-text').slideDown('fast');
		patternTest( pattern.charLength(), helperText.charLength );
		patternTest( pattern.lowercase(), helperText.lowercase );
		patternTest( pattern.uppercase(), helperText.uppercase );
		patternTest( pattern.special(), helperText.special );
    
	    if( hasClass(helperText.charLength, 'valid') &&
			hasClass(helperText.lowercase, 'valid') && 
			hasClass(helperText.uppercase, 'valid') && 
			hasClass(helperText.special, 'valid')
		) {
			addClass(password.parentElement, 'valid');
	    }
	    else {
			removeClass(password.parentElement, 'valid');
	    }
	}
	if(password) {
		password.addEventListener('keyup', CheckCPassword);
		password.addEventListener('input', CheckCPassword);
	}
  
	function patternTest(pattern, response) {
		if(pattern) {
			addClass(response, 'valid');
		} else {
			removeClass(response, 'valid');
		}
	}
	function addClass(el, className) {
		if (el && el.classList) {
			el.classList.add(className);
		}
	}
	function removeClass(el, className) {
		if (el && el.classList) {
			el.classList.remove(className);
		}
	}
	function hasClass(el, className) {
		if (el && el.classList) {
			return el.classList.contains(className);	
		}
		return false;
	}
})();
<?php } ?>

$(document).ready(function () {
	// Password Toggle
	$(".toggle-password").on("click", function (e) {
		e.preventDefault();
		let passwordInput = $("#password");
		let $btn = $(this);

		if (passwordInput.attr("type") === "password") {
			passwordInput.attr("type", "text");
			$btn.addClass("active");
			$btn.find(".eye-open").addClass("d-none");
			$btn.find(".eye-closed").removeClass("d-none");
		} else {
			passwordInput.attr("type", "password");
			$btn.removeClass("active");
			$btn.find(".eye-closed").addClass("d-none");
			$btn.find(".eye-open").removeClass("d-none");
		}
	});

	// Confirm Password Toggle
	$(".toggle-confirm-password").on("click", function (e) {
		e.preventDefault();
		let confirmInput = $("#confirm_password");
		let $btn = $(this);

		if (confirmInput.attr("type") === "password") {
			confirmInput.attr("type", "text");
			$btn.addClass("active");
			$btn.find(".eye-open").addClass("d-none");
			$btn.find(".eye-closed").removeClass("d-none");
		} else {
			confirmInput.attr("type", "password");
			$btn.removeClass("active");
			$btn.find(".eye-closed").addClass("d-none");
			$btn.find(".eye-open").removeClass("d-none");
		}
	});
});
</script>
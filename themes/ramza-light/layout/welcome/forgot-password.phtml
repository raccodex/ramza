<script>
var working = false;
var $this = $('#forgot-form');
var $this_sms = $('#forgot-form-sms');
var $state = $this.find('.errors');
var $state_sms = $this_sms.find('.errors');
var $login_anim = $this.find('.tag_auth_animation');
var $login_anim_phone = $this_sms.find('.tag_auth_animation');

$(function() {
	$('#recover_password_by_email').click(function(){
		$('.x_chooser').hide();
		$('.recover_password_by_email').fadeIn(250);
	});
	$('#recover_password_by_sms').click(function(){
		$('.x_chooser').hide();
		$('.recover_password_by_sms').fadeIn(250);
	});

	if (typeof Wo_SetTimer === 'function') {
		Wo_SetTimer();
	}
	
	$this.ajaxForm({
		url: Wo_Ajax_Requests_File() + '?f=recover',
		beforeSend: function() {
			working = true;
			var $btn = $this.find('.disable_btn');
			$btn.attr("disabled", true);
			$btn.find('.btn_text').html('<span class="tag_btn_spinner"></span> <?php echo $wo['lang']['please_wait'] ?? "Please wait..."; ?>');
		},
		success: function(data) {
			if (data.status == 200) {
				$login_anim.removeClass('d-none');
			} else {
				var $btn = $this.find('.disable_btn');
				$btn.attr("disabled", false);
				$btn.find('.btn_text').text('<?php echo $wo['lang']['recover_password']?>');
				$state.html(data.errors);
				$state.show();
			}
			working = false;
		}
	});

	$this_sms.ajaxForm({
		url: Wo_Ajax_Requests_File() + '?f=recoversms',
		beforeSend: function() {
			working = true;
			var $btn = $this_sms.find('.disable_btn');
			$btn.attr("disabled", true);
			$btn.find('.btn_text').html('<span class="tag_btn_spinner"></span> <?php echo $wo['lang']['please_wait'] ?? "Please wait..."; ?>');
		},
		success: function(data) {
			if (data.status == 200) {
				$login_anim_phone.removeClass('d-none');
				setTimeout(function () {
					window.location.href = data.location;
				}, 1000);
			} else {
				var $btn = $this_sms.find('.disable_btn');
				$btn.attr("disabled", false);
				$btn.find('.btn_text').text('<?php echo $wo['lang']['recover_password']?>');
				$state_sms.html(data.errors);
				$state_sms.show();
			}
			working = false;
		}
	});
});
</script>
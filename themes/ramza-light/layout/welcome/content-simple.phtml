<script>
var working = false;
var $this = $('#login');
var $state = $this.find('.errors');
var $login_anim = $('.tag_auth_animation');

// Interactive password show/hide eye toggle
$(document).ready(function() {
	$('#toggle_login_pwd').on('click', function(e) {
		e.preventDefault();
		var $pwd = $('#login_password');
		var $btn = $(this);
		if ($pwd.attr('type') === 'password') {
			$pwd.attr('type', 'text');
			$btn.addClass('active');
			$btn.find('.eye_open').addClass('d-none');
			$btn.find('.eye_closed').removeClass('d-none');
		} else {
			$pwd.attr('type', 'password');
			$btn.removeClass('active');
			$btn.find('.eye_closed').addClass('d-none');
			$btn.find('.eye_open').removeClass('d-none');
		}
	});
});

<?php if($wo['config']['googleLogin'] != 0): ?>
function handleCredentialResponse(response) {
   var id_token = response.credential;
   $.post(Wo_Ajax_Requests_File() + '?f=google_login', {id_token: id_token}, function(data, textStatus, xhr) {
      if (data.status == 200) {
         $state.addClass('success');
         $state.html('<?php echo $wo['lang']['welcome_back'] ?>');
         $this.find('.loading').addClass('hidden');
         setTimeout(function () {
            window.location.href = data.location;
         }, 1000);
      }
      else{
         $this.find('button').attr("disabled", false);
         $this.find('.loading').addClass('hidden');
         $state.html(data.message);
      }
   });
}
window.onload = function () {
  google.accounts.id.initialize({
    client_id: "<?php echo $wo['config']['googleAppId']?>",
    callback: handleCredentialResponse
  });
  var btnWrap = document.getElementById("buttonDiv");
  var btnW = btnWrap ? btnWrap.offsetWidth : 368;
  if (!btnW || btnW < 200) { btnW = 368; }
  if (btnW > 400) { btnW = 368; }
  google.accounts.id.renderButton(
    document.getElementById("buttonDiv"),
    { theme: "outline", size: "large", type: "standard", text: "continue_with", shape: "rectangular", width: btnW, logo_alignment: "left" }
  );
  google.accounts.id.prompt();
}
<?php endif; ?>

$(function() {
  $('#login').ajaxForm({
    url: Wo_Ajax_Requests_File() + '?f=login',
    beforeSend: function() {
		working = true;
		var $btn = $this.find('.disable_btn');
		$btn.attr("disabled", true);
		$btn.find('.btn_text').html('<span class="tag_btn_spinner"></span> <?php echo $wo['lang']['please_wait'] ?? "Please wait..."; ?>');
    },
    success: function(data) {
      if (data.status == 200 || data.status == 600) {
      	$login_anim.removeClass('d-none');
        setTimeout(function () {
        	window.location.href = data.location;
        }, 1000);
      } else {
        var errors = (data.errors && Array.isArray(data.errors)) ? data.errors.join("<br>") : (data.errors || data.message || 'An error occurred');
        $state.html(errors);
        $state.show();
      } 
      working = false;
	  var $btn = $this.find('.disable_btn');
	  $btn.attr("disabled", false);
	  $btn.find('.btn_text').text('<?php echo $wo['lang']['login']?>');
    }
  });
});
</script>